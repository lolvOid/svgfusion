{
  "name": "svgfusion-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "SVGFusion monorepo - Convert SVG files to React/Vue components",
  "packageManager": "pnpm@10.13.1",
  "author": "lolvoid",
  "license": "MIT",
  "scripts": {
    "build:utils": "pnpm --filter=svgfusion-utils run build",
    "build:core": "pnpm --filter=svgfusion-core run build",
    "build:react": "pnpm --filter=svgfusion-react run build",
    "build:vue": "pnpm --filter=svgfusion-vue run build",
    "build:react-native": "pnpm --filter=svgfusion-react-native run build",
    "build:browser": "pnpm --filter=svgfusion-dom run build",
    "build:cli": "pnpm --filter=svgfusion-cmd run build",
    "build:vscode": "pnpm --filter=svgfusion-vscode run build",
    "build:bundle": "pnpm --filter=svgfusion run build",
    "build": "pnpm run build:utils && pnpm run build:core && pnpm run build:react && pnpm run build:vue && pnpm run build:react-native && pnpm run build:browser && pnpm run build:cli && pnpm run build:vscode && pnpm run build:bundle",
    "dev:utils": "pnpm --filter=svgfusion-utils run dev",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r --filter='!svgfusion-docs' --filter='!svgfusion-demo' test",
    "test:coverage": "pnpm --filter=svgfusion run test:coverage",
    "test:watch": "pnpm -r --filter='!svgfusion-docs' --filter='!svgfusion-demo' test:watch",
    "lint": "pnpm -r --filter='!svgfusion-demo' lint",
    "lint:fix": "pnpm -r --filter='!svgfusion-demo' lint:fix",
    "format": "pnpm -r --filter='!svgfusion-demo' format",
    "format:check": "pnpm -r --filter='!svgfusion-demo' format:check",
    "type-check": "pnpm -r --filter='!svgfusion-docs' --filter='!svgfusion-demo' type-check",
    "clean": "pnpm -r clean",
    "prepare": "husky install",
    "release:bundle": "pnpm --filter=svgfusion run release",
    "release:vscode": "pnpm --filter=svgfusion-vscode run release",
    "release:cli": "pnpm --filter=svgfusion-cmd run release",
    "release:browser": "pnpm --filter=svgfusion-dom run release",
    "release:react": "pnpm --filter=svgfusion-react run release",
    "release:vue": "pnpm --filter=svgfusion-vue run release",
    "release:utils": "pnpm --filter=svgfusion-utils run release",
    "release:core": "pnpm --filter=svgfusion-core run release",
    "release:react-native": "pnpm --filter=svgfusion-react-native run release",
    "release:all": "pnpm run release:utils && pnpm run release:core && pnpm run release:react && pnpm run release:vue && pnpm run release:react-native && pnpm run release:browser && pnpm run release:cli && pnpm run release:vscode && pnpm run release:bundle",
    "svgfusion": "node packages/svgfusion-bundle/dist/cli.cjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^3.2.2",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@eslint/js": "^9.31.0",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.37.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@semantic-release/github": {
      "semantic-release": "^24.2.5"
