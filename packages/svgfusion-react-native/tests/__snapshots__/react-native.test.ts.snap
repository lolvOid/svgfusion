  const computedSize = {
    width: svgProps.width || size || 24,
    height: svgProps.height || size || 24,
  };

  return (
    <Svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      role="img"
      aria-labelledby={[titleId, descId].filter(Boolean).join(' ')}
      {...svgProps}
      {...computedSize}
